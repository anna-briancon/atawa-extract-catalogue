GEMINI_API_KEY=Cle_API_Gemini

# Active ou désactive la détection YOLO.
# true = active la détection d'images/objets
# false = désactive YOLO pour accélérer les traitements
ENABLE_YOLO=true

# Mode debug Flask.
# true = logs détaillés + rechargement automatique (développement)
# false = mode production recommandé
FLASK_DEBUG=false